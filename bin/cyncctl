#!/bin/sh
# cyncctl launcher — runs the in-tree package without installation.
# readlink -f resolves symlinked installs (e.g. ~/.local/bin/cyncctl).
SELF=$(readlink -f "$0") || exit 1
DIR=$(CDPATH= cd -- "$(dirname -- "$SELF")/.." && pwd)
PYTHONPATH="$DIR${PYTHONPATH:+:$PYTHONPATH}" exec python3 -m cyncctl "$@"
